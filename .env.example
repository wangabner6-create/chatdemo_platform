# Example environment for ChatDemo. Copy this to `.env` and fill it in.
#   Docker Compose:  cp .env.example .env  ->  docker compose up --build
#   Local backend:   set -a; . ./.env; set +a  ->  cd chatdemo && uv run chatdemo
#
# NOTE: put each comment on its own line. Docker Compose parses this file for
# variable substitution and treats anything after `#` on a value line as part
# of that value — an inline comment would silently corrupt the setting.
#
# Out of the box (nothing filled in below) the platform talks to a local Redis
# and uses the built-in mock model — no provider account needed. Fill in the
# provider section to switch to a live model. For a credential-free real local
# agent, install Ollama and use http://127.0.0.1:11434/v1 with any chat-capable
# model plus a separate embedding model.

# ── Model provider ────────────────────────────────────────────────────────────
# Leaving CHATDEMO_BASE_URL blank keeps the built-in mock client active (fully
# offline, nothing real gets called). Fill in BASE_URL + API_KEY + MODEL to talk
# to any OpenAI-compatible endpoint.

# e.g. https://api.your-provider.com/v1   (blank => mock model)
CHATDEMO_BASE_URL=
# your provider key
CHATDEMO_API_KEY=

# ── Per-role models ───────────────────────────────────────────────────────────
# Each agent role can have its own model. CHATDEMO_MODEL is mandatory and acts
# as the default; every other role falls back to it unless overridden. Each
# role also has its own API style (completion | response), falling back to
# CHATDEMO_API_STYLE the same way.
#
# base model for every role that doesn't set its own (REQUIRED to go live)
CHATDEMO_MODEL=mock
CHATDEMO_API_STYLE=completion
# Caps completion length. Reasoning-heavy models can otherwise default to huge
# output budgets, which slows down simple replies and costs more than it should.
CHATDEMO_MAX_TOKENS=2048
# Provider-specific chat-template toggle. Leave blank to use the provider's
# default; set to false to skip reasoning mode on models that support it, for
# quicker non-reasoning replies.
CHATDEMO_ENABLE_THINKING=
# picks which specialist handles a message
CHATDEMO_ROUTER_MODEL=
CHATDEMO_ROUTER_API_STYLE=
# used by every skill (a skill with `web_search: true` always uses Responses regardless)
CHATDEMO_SKILL_MODEL=
CHATDEMO_SKILL_API_STYLE=
# runs each workflow's steps
CHATDEMO_WF_MODEL=
# leave blank to respect each workflow's own `runner.api_style`; set to override all of them
CHATDEMO_WF_API_STYLE=
# generates the related-question suggestions
CHATDEMO_RELATED_MODEL=
CHATDEMO_RELATED_API_STYLE=

# ── Sessions, pending approvals & feedback (Redis Stack by default) ────────────
# Conversation history, tool-approval state, and UI feedback are all stored in
# Redis Stack (Redis + RediSearch); Compose starts redis/redis-stack-server for
# you automatically. Feedback lands in the `feedbackchatbot` RediSearch index —
# both the thumbs-up/down and free-text sidebar box (POST /feedback) and the
# submit_feedback in-chat tool write there.
# The value below is for running Redis on your own machine; Compose overrides
# it to redis://redis:6379/0 for you.
# Leave CHATDEMO_REDIS_URL blank to skip Redis entirely and fall back to SQLite
# for sessions plus an in-memory store for pending approvals — handy for local dev.
CHATDEMO_REDIS_URL=redis://localhost:6379/0
# how long a session stays alive between messages, seconds (30 days; 0 = forever)
CHATDEMO_SESSION_TTL=2592000
# how long a pending confirmation stays valid, seconds (1 hour)
CHATDEMO_PENDING_TTL=3600
# where SQLite stores sessions — only read when CHATDEMO_REDIS_URL is empty
# CHATDEMO_AGENTS_DB=.agents_sessions.db

# ── Content selection & routing ──────────────────────────────────────────────
# Every workflow/skill ships in the image; these settings control which ones
# are actually turned on and how a message gets routed to one of them.
# comma-separated list of workflow/skill names to enable (blank = enable everything)
CHATDEMO_ENABLED=
# skip the LLM router entirely and always use this one handler (blank = normal routing). e.g. demo-assistant
CHATDEMO_ROUTE=

# ── Admin ────────────────────────────────────────────────────────────────────
# Secret that unlocks the read-only feedback endpoint (GET /feedback). Leave it
# blank and the endpoint returns 403 for everyone. Set a strong value to enable
# it; callers must send it back in the X-Admin-Token header.
CHATDEMO_ADMIN_TOKEN=

# ── Retrieval (per-workflow) ──────────────────────────────────────────────────
# Retrieval is configured per workflow, inside that workflow's own workflow.yaml
# (its `retriever:` block).
# See skills/authoring-chatdemo-workflows/ for how retrievers and fixtures work.
# The bundled docs-assistant index records its embedding/rerank models in
# index/meta.json. These values are used when rebuilding that index.
# CHATDEMO_EMBED_MODEL=qwen3-embedding:0.6b
# Set to disabled when the provider has no /rerank endpoint; vector search remains active.
# CHATDEMO_RERANK_MODEL=disabled

# ── Structured tracing (Arize Phoenix) ────────────────────────────────────────
# Install once with: cd chatdemo && uv sync --extra dev --extra observability
# Start local Phoenix with: uv run phoenix serve
CHATDEMO_TRACING=off
CHATDEMO_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
CHATDEMO_TRACE_PROJECT=chatdemo
# Phoenix SDK base URL used when publishing evaluation datasets/experiments.
CHATDEMO_PHOENIX_URL=http://127.0.0.1:6006
# Optional CLI default; `chatdemo-eval --phoenix` overrides it for one run.
CHATDEMO_EVAL_PUBLISH_PHOENIX=false
# Optional human-readable version; when blank the evaluator hashes code/content/model config.
CHATDEMO_EVAL_VERSION=

# ── Safety ────────────────────────────────────────────────────────────────────
# on | off — the LLM-based safety check that screens incoming messages
CHATDEMO_SAFETY=on
# on | off — whether skills may execute their bundled scripts/ (still allowlisted,
# run with a clean environment, and time-limited; this is a safety layer, not a
# sandbox). Set to off to disable script execution altogether.
CHATDEMO_SKILL_SCRIPTS=on
# how long a bundled script may run before being killed, seconds
CHATDEMO_SCRIPT_TIMEOUT=20

# ── Advanced (usually fine to leave alone) ────────────────────────────────────
# A skill with `web_search: true` automatically gets the provider's hosted
# search tool via the Responses API. The two settings below only matter for a
# WORKFLOW's own model calls when running in response mode.
# CHATDEMO_HOSTED_TOOLS=web_search
# CHATDEMO_WEBSEARCH_TOOL=web_search
